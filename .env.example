# Template for .env — copy it and fill in real values:
#
#   cp .env.example .env
#
# This file is committed and must never contain a real secret. The .env you
# create from it is ignored by git (see .gitignore).

# LeetCode session cookie, used by `npm run scrape` to authenticate against
# LeetCode's GraphQL API.
#
# Optional: the scraper runs fine without it, but the per-problem "companies"
# field comes back empty (companyTagStats is null for anonymous requests).
#
# Where to get it: log in to leetcode.com, then DevTools ->
# Application -> Cookies -> https://leetcode.com -> copy the LEETCODE_SESSION
# value. It is a long-lived credential tied to your account — treat it like a
# password, and rotate it (log out) if it ever leaks.
LEETCODE_SESSION=

# Supabase Postgres connection string, used by the Next.js app and by
# `npm run db:setup` / `npm run backup` / `npm run repopulate`.
#
# Format (direct connection):
#   postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
#
# The direct host is IPv6-only on some networks; if connections time out,
# use the session pooler instead (Supabase dashboard -> Connect):
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
#
# Percent-encode any @ : / # ? % characters in the password. Rotate the
# password from the Supabase dashboard (Settings -> Database) if it leaks.
DATABASE_URL=
