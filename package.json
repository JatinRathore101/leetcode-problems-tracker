{
  "name": "leetcode-problems",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "(sleep 2 && open http://localhost:4321) & next dev -p 4321",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scrape": "node --env-file-if-exists=.env script/scrapper.js",
    "parse": "node script/parser.js",
    "transaction": "node --env-file-if-exists=.env script/transaction.js",
    "backup": "node --env-file-if-exists=.env script/backup.js",
    "dump": "node --env-file-if-exists=.env script/repopulate.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "next": "^15.5.7",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "axios": "^1.18.1",
    "prettier": "3.9.5"
  }
}
